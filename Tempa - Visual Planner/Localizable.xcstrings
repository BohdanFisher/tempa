    "No nagging here, just a gentle wave. Your session's quietly waiting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Nörgeln, nur ein sanftes Winken. Deine Session wartet still."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada de sermones, solo un saludo suave. Tu sesión espera en silencio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei nalkutusta, vain lempeä vilkutus. Istuntosi odottaa hiljaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
