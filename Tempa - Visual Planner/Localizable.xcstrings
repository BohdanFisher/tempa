        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen gezeur, alleen een zacht seintje. Je sessie wacht rustig op je."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada de cobrança, só um aceno gentil. Sua sessão espera em silêncio."
