    "No focus sessions in this period — the timer's there whenever you're ready.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Fokus-Sessions in diesem Zeitraum — der Timer wartet, wann immer du bereit bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin sesiones de enfoque en este período: el temporizador te espera cuando quieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei keskittymisjaksoja tällä välillä — ajastin odottaa, kun olet valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de sessions de focus sur cette période — le minuteur t'attend quand tu veux."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen fokusøkter i denne perioden — timeren er der når du er klar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen focussessies in deze periode — de timer staat klaar wanneer jij dat bent."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem sessões de foco neste período — o timer está lá quando você quiser."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає фокус-сесій за цей період — таймер чекає, коли будеш готовий."
          }
        }
      }
    },
