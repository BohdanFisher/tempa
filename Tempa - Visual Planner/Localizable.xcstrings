    "Hey — let's untangle this. What feels heaviest right now?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hey — lass uns das entwirren. Was fühlt sich gerade am schwersten an?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola — vamos a desenredar esto. ¿Qué es lo que más pesa ahora mismo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hei — puretaan tämä vyyhti. Mikä painaa juuri nyt eniten?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salut — on va démêler tout ça. Qu'est-ce qui te pèse le plus, là ?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hei — la oss nøste opp i dette. Hva kjennes tyngst akkurat nå?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hé — laten we dit ontwarren. Wat voelt nu het zwaarst?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi — vamos desembaraçar isso. O que está pesando mais agora?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привіт. Розплутаймо це. Що зараз тисне найбільше?"
          }
        }
      }
    },
    "Hey." : {
      "extractionState" : "stale",
