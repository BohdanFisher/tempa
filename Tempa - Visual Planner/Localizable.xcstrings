    "More planned than the day has left — be gentle with yourself, maybe move something to tomorrow.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr geplant, als der Tag noch hergibt — sei nachsichtig mit dir, verschiebe vielleicht etwas auf morgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay más planificado de lo que queda de día: sé amable contigo, quizá mueve algo a mañana."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suunniteltua on enemmän kuin päivää jäljellä — ole itsellesi lempeä, siirrä ehkä jotain huomiselle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de choses prévues qu'il ne reste de journée — sois indulgent·e, déplace peut-être un truc à demain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mer planlagt enn dagen har igjen — vær snill med deg selv, flytt kanskje noe til i morgen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meer gepland dan de dag nog heeft — wees lief voor jezelf, verplaats misschien iets naar morgen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais planejado do que resta do dia — pegue leve com você, talvez mova algo para amanhã."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заплановано більше, ніж лишилося дня — будь до себе лагідним, може, перенеси щось на завтра."
          }
        }
      }
    },
    "Move": {
