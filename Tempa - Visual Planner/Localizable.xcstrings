    "Pick all that feel true. We'll tune Tempa to you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle alles, was zutrifft. Wir stimmen Tempa auf dich ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige todo lo que te suene. Ajustaremos Tempa a ti."
