    "Miss a day? Tempa just says: welcome back. We'll pick the next small thing together." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Tag verpasst? Tempa sagt nur: willkommen zurück. Wir suchen zusammen den nächsten kleinen Schritt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Faltaste un día? Tempa solo dice: bienvenido de nuevo. Elegiremos juntos lo siguiente pequeño."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jäikö päivä väliin? Tempa sanoo vain: tervetuloa takaisin. Valitaan seuraava pieni juttu yhdessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un jour raté ? Tempa dit juste : content de te revoir. On choisira ensemble le prochain petit truc."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mistet en dag? Tempa sier bare: velkommen tilbake. Vi finner neste lille ting sammen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een dag gemist? Tempa zegt gewoon: welkom terug. We kiezen samen de volgende kleine stap."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulou um dia? O Tempa só diz: bem-vindo de volta. Vamos escolher juntos a próxima coisinha."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропустив день? Tempa просто скаже: з поверненням. Разом виберемо наступне мале завдання."
          }
        }
      }
    },
