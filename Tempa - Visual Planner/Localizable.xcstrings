        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coche tout ce qui te parle. On adaptera Tempa à toi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg alt som stemmer. Vi tilpasser Tempa til deg."
