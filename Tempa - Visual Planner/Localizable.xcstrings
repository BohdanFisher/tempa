    "You stepped away, and that's okay. Your tempo's still flowing when you want it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du warst kurz weg, und das ist okay. Dein Tempo fließt weiter, wann immer du willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te alejaste y está bien. Tu tempo sigue fluyendo cuando lo quieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistuit hetkeksi, eikä se haittaa. Temposi virtaa yhä, kun haluat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu t'es éloigné·e, et c'est ok. Ton tempo coule toujours quand tu le veux."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gikk litt bort, og det er greit. Tempoet ditt flyter fortsatt når du vil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je liep even weg, en dat is oké. Je tempo stroomt nog wanneer jij wilt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você se afastou, e tudo bem. Seu ritmo continua fluindo quando quiser."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти відійшов — і це окей. Твій темп нікуди не зник, він чекає на тебе."
          }
        }
      }
    },
    "You took a few\ndays off. That's okay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast ein paar\nTage pausiert. Alles gut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te tomaste unos\ndías libres. Está bien."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidit muutaman\npäivän tauon. Ei se mitään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as pris quelques\njours de pause. C'est ok."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tok noen\ndager fri. Det er greit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je nam een paar\ndagen vrij. Prima."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tirou uns\ndias de folga. Tudo bem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти взяв кілька\nднів перерви. Це окей."
          }
        }
      }
    },
