        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi, noe gikk galt. Fortell hva som kjennes tyngst — jobb, hjem eller kropp?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oeps, er ging iets mis. Vertel wat het zwaarst voelt — werk, thuis of je lijf?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opa, algo travou. Me diz o que pesa mais — trabalho, casa ou corpo?"
