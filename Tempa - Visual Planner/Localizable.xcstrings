    },
    "Say your day out loud. We'll turn it into steps you can actually start." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich deinen Tag einfach aus. Wir machen daraus Schritte, die du wirklich anfangen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di tu día en voz alta. Lo convertiremos en pasos que de verdad puedas empezar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sano päiväsi ääneen. Muutamme sen askeliksi, jotka oikeasti pystyt aloittamaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dis ta journée à voix haute. On la transforme en étapes que tu peux vraiment commencer."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si dagen din høyt. Vi gjør den om til steg du faktisk kan begynne på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spreek je dag hardop uit. Wij maken er stappen van waar je echt aan kunt beginnen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fale seu dia em voz alta. A gente transforma em passos que você realmente consegue começar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наговори свій день уголос. Ми перетворимо його на кроки, які реально почати."
          }
        }
      }
    },
    "Scrolling counts. Honest guess — nobody's judging." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrollen zählt mit. Schätz ehrlich — hier urteilt niemand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El scroll también cuenta. Haz una estimación honesta — nadie te juzga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selaaminenkin lasketaan. Arvioi rehellisesti — kukaan ei tuomitse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scroll compte aussi. Estime honnêtement — personne ne te juge."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrollingen teller også. Et ærlig anslag — ingen dømmer deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrollen telt ook mee. Schat eerlijk — niemand oordeelt."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scroll também conta. Pode chutar com sinceridade — ninguém vai julgar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скролінг теж рахується. Прикинь чесно — ніхто не засуджує."
          }
        }
      }
    },
    "See? Not so scary when it's this small." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siehst du? Gar nicht so schlimm, wenn es so klein ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ves? No da tanto miedo cuando es así de pequeño."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näetkö? Ei niin pelottavaa, kun se on näin pientä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu vois ? Moins effrayant quand c'est aussi petit."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser du? Ikke så skummelt når det er så smått."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie je? Niet zo eng als het zo klein is."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viu? Não é tão assustador quando é pequeno assim."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бачиш? Зовсім не страшно, коли крок такий малий."
          }
        }
      }
    },
