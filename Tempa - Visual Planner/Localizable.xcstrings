    "As you complete tasks, you'll see when in the week you shine.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du Aufgaben erledigst, siehst du, wann in der Woche du glänzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al completar tareas verás cuándo brillas en la semana."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun saat tehtäviä valmiiksi, näet milloin viikossa loistat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En accomplissant des tâches, tu verras quand tu brilles dans la semaine."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter hvert som du fullfører oppgaver, ser du når i uken du skinner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naarmate je taken afrondt, zie je wanneer in de week je straalt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conforme concluir tarefas, você verá quando brilha na semana."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли виконуватимеш задачі, побачиш, у які години тижня ти сяєш."
          }
        }
      }
    },
