        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du blir belastet %@. Si opp når som helst før den tid – det tar to trykk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op %@ wordt het bedrag afgeschreven. Tot dan kun je altijd opzeggen – twee tikjes en klaar."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
