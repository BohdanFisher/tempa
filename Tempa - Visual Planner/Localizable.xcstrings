    },
    "Time blindness: visual blocks keep the day where you can see it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitblindheit: Visuelle Blöcke halten deinen Tag im Blick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceguera temporal: los bloques visuales mantienen tu día a la vista."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aikasokeus: visuaaliset lohkot pitävät päivän näkyvillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cécité temporelle : des blocs visuels gardent ta journée sous tes yeux."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidsblindhet: Visuelle blokker holder dagen synlig foran deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdblindheid: visuele blokken houden je dag in beeld."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cegueira temporal: blocos visuais mantêm o dia à sua frente."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сліпота до часу: візуальні блоки тримають день перед очима."
          }
        }
      }
    },
    "Time slips away — your day becomes blocks you can actually see." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeit rutscht dir weg — dein Tag wird zu Blöcken, die du wirklich vor dir siehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tiempo se te escapa — tu día se convierte en bloques que puedes ver de verdad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aika karkaa huomaamatta — päiväsi muuttuu lohkoiksi, jotka näet selkeästi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps t’échappe — ta journée devient des blocs que tu peux vraiment visualiser."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiden glipper — dagen din blir til blokker du faktisk kan se."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tijd glipt weg — je dag wordt opgedeeld in blokken die je echt kunt zien."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo escapa — seu dia vira blocos que você consegue enxergar de verdade."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Час непомітно зникає — Tempa перетворює день на блоки, які ти справді бачиш."
          }
        }
      }
