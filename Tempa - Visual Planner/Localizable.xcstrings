        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te tomaste unos\ndías libres. Está bien."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidit muutaman\npäivän tauon. Ei se mitään."
          }
        },
        "fr" : {
