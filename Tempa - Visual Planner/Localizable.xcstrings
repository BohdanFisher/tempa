    "Your focus is paused on the world, not on you. Drop back in, no pressure.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Fokus pausiert die Welt, nicht dich. Steig wieder ein, ganz ohne Druck."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu enfoque pausa el mundo, no a ti. Vuelve cuando quieras, sin presión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskittymisesi laittoi maailman tauolle, ei sinua. Palaa mukaan, ilman paineita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton focus met le monde en pause, pas toi. Reviens, sans pression."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokuset ditt har satt verden på pause, ikke deg. Hopp inn igjen, uten press."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je focus zet de wereld op pauze, niet jou. Stap weer in, zonder druk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu foco pausou o mundo, não você. Volte sem pressão."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фокус поставив на паузу світ, а не тебе. Повертайся без жодного тиску."
          }
        }
      }
    },
