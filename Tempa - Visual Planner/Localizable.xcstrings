    "Soft sound, no buzz, no badges. We promise not to be annoying." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leiser Ton, kein Vibrieren, keine Badges. Versprochen: Wir nerven nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonido suave, sin vibración, sin insignias. Prometemos no ser pesados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pehmeä ääni, ei värinää, ei merkkejä. Lupaamme olla häiritsemättä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son doux, pas de vibration, pas de pastilles. Promis, on ne sera pas pénibles."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myk lyd, ingen vibrering, ingen merker. Vi lover å ikke mase."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zacht geluid, geen trilling, geen badges. Beloofd: we worden niet irritant."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som suave, sem vibração, sem selos. Prometemos não incomodar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тихий звук, жодних вібрацій та бейджів. Обіцяємо не набридати."
          }
        }
      }
    },
    "Sorry, I hit a snag. Try telling me what area feels heaviest — work, home, or body?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ups, da hakt was. Sag mir, was sich gerade am schwersten anfühlt — Arbeit, Zuhause oder Körper?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaya, algo falló. Dime qué pesa más — ¿trabajo, casa o cuerpo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hups, jokin takkusi. Kerro mikä painaa eniten — työ, koti vai keho?"
