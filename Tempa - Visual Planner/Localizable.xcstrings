    "Cautious is smart. Tempa earns trust one small win at a time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorsichtig zu sein ist klug. Tempa verdient sich dein Vertrauen — mit einem kleinen Erfolg nach dem anderen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ir con cautela es buena idea. Tempa se gana tu confianza con cada pequeña victoria."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varovaisuus on fiksua. Tempa ansaitsee luottamuksesi yksi pieni onnistuminen kerrallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prudence, c’est malin. Tempa gagne ta confiance, petite victoire après petite victoire."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er smart å være forsiktig. Tempa bygger tillit én liten seier om gangen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorzichtig zijn is slim. Tempa verdient je vertrouwen met kleine overwinningen, stap voor stap."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ir com calma é inteligente. O Tempa conquista sua confiança com pequenas vitórias, uma de cada vez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обережність — це розумно. Tempa завойовує довіру маленькими перемогами, крок за кроком."
          }
        }
      }
    },
