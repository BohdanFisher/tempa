        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Con qué frecuencia una tarea grande te bloquea y todo termina quedando «para después»?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka usein yksi iso tehtävä saa sinut jumiin — ja kaikki siirtyy ”myöhemmäksi”?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À quelle fréquence une grosse tâche te bloque — et tout finit repoussé à « plus tard » ?"
