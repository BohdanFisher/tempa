    "Tempa shows you one thing at a time — so you can find your rhythm again." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempa zeigt dir eins nach dem anderen — damit du deinen Rhythmus wiederfindest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempa te muestra una cosa a la vez, para que recuperes tu ritmo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempa näyttää yhden asian kerrallaan — jotta löydät rytmisi uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempa te montre une chose à la fois — pour retrouver ton rythme."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempa viser deg én ting om gangen — så du finner rytmen din igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempa laat één ding tegelijk zien — zodat je je ritme terugvindt."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tempa mostra uma coisa de cada vez — para você achar seu ritmo de novo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempa показує одне завдання за раз — так ти зможеш повернути свій ритм."
          }
        }
      }
    },
