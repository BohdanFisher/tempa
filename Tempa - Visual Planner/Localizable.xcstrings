    "The guilt: banned. A missed day just gets a \"welcome back.\"" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schuldgefühle: verboten. Nach einem verpassten Tag gibt’s einfach ein „Willkommen zurück“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La culpa: prohibida. Si te saltas un día, solo hay un «qué bueno tenerte de vuelta»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syyllisyys: kielletty. Jos yksi päivä jää väliin, vastassa on vain ”tervetuloa takaisin”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La culpabilité : interdite. Si tu rates une journée, tu as juste droit à un « te revoilà »."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skyldfølelse: forbudt. Hopper du over en dag, får du bare et «velkommen tilbake»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schuldgevoel: verboden. Na een gemiste dag krijg je gewoon een ‘welkom terug’."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Culpa: proibida. Perdeu um dia? Você só recebe um “que bom ter você de volta”."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почуття провини: під забороною. Пропущений день — це просто привід сказати «з поверненням»."
          }
        }
      }
