    "Lost the thread for a sec? Totally normal. Your focus is right where you left it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurz den Faden verloren? Ganz normal. Dein Fokus ist genau da, wo du ihn gelassen hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Perdiste el hilo un segundo? Normal. Tu enfoque está donde lo dejaste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadotitko langan hetkeksi? Ihan normaalia. Keskittymisesi on juuri siinä, mihin jätit sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as perdu le fil une seconde ? C'est normal. Ton focus est là où tu l'as laissé."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistet tråden et øyeblikk? Helt normalt. Fokuset ditt er der du forlot det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Even de draad kwijt? Heel normaal. Je focus is precies waar je hem achterliet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdeu o fio por um segundo? Super normal. Seu foco está onde você deixou."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Загубив нитку на мить? Це нормально. Твій фокус там, де ти його залишив."
          }
        }
      }
    },
    "MIN": {
      "localizations": {
        "de": {
