    "Tap + to add something,\nor let AI break it down.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe +, um etwas hinzuzufügen,\noder lass die KI es zerlegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca + para añadir algo,\no deja que la IA lo desglose."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta + lisätäksesi jotain,\ntai anna tekoälyn pilkkoa se."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche + pour ajouter,\nou laisse l'IA le découper."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk + for å legge til,\neller la KI dele det opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik + om iets toe te voegen,\nof laat AI het opdelen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque + para adicionar algo,\nou deixe a IA dividir em passos."
          }
        },
        "uk": {
