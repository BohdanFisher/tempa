    "For the first time, I finish things. I just see the tiny next step and go.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum ersten Mal bringe ich Dinge zu Ende. Ich sehe nur den kleinen nächsten Schritt und lege los."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por primera vez termino las cosas. Solo veo el pequeño paso siguiente y voy."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensimmäistä kertaa saan asiat valmiiksi. Näen vain pienen seuraavan askeleen ja menen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour la première fois, je finis ce que je commence. Je vois juste le petit pas suivant et j'y vais."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For første gang fullfører jeg ting. Jeg ser bare det lille neste steget og går."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor het eerst maak ik dingen af. Ik zie gewoon het kleine volgende stapje en ga."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pela primeira vez eu termino as coisas. Só vejo o próximo passinho e vou."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уперше я доводжу справи до кінця. Просто бачу крихітний наступний крок — і роблю."
          }
        }
      }
    },
