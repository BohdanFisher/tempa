            "value": "Gute Arbeit. Genieß den Rest des Tages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buen trabajo. Disfruta el resto del día."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyvää työtä. Nauti loppupäivästä."
          }
        },
