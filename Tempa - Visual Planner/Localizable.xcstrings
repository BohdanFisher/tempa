    "Unlock all of Tempa free for 3 days. Keep it for less than a coffee a month.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte ganz Tempa 3 Tage gratis frei. Behalte es für weniger als einen Kaffee im Monat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea todo Tempa gratis 3 días. Quédatelo por menos que un café al mes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa koko Tempa ilmaiseksi 3 päiväksi. Pidä se halvemmalla kuin kahvi kuussa."
