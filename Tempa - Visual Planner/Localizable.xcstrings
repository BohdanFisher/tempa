        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche + pour ajouter,\nou laisse l'IA le découper."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk + for å legge til,\neller la KI dele det opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik + om iets toe te voegen,\nof laat AI het opdelen."
          }
        },
        "pt": {
