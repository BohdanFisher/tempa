    "You'll be charged on %@. Cancel anytime before — it takes two taps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am %@ wird abgebucht. Bis dahin kannst du jederzeit kündigen – zweimal tippen, fertig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se te cobrará el %@. Cancela cuando quieras antes de esa fecha: son solo dos toques."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veloitus tapahtuu %@. Voit perua milloin tahansa sitä ennen – kaksi napautusta riittää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le prélèvement aura lieu le %@. Tu peux annuler quand tu veux avant cette date, en deux clics."
