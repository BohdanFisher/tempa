            "value": "Der Store ist noch nicht erreichbar. Warte kurz und versuch es nochmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tienda aún no responde. Espera un momento e inténtalo de nuevo."
