    "No nagging here, just a gentle wave. Your session's quietly waiting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Nörgeln, nur ein sanftes Winken. Deine Session wartet still."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de sermones, solo un saludo suave. Tu sesión espera en silencio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei nalkutusta, vain lempeä vilkutus. Istuntosi odottaa hiljaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de reproches, juste un petit signe. Ta session t'attend tranquillement."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen mas, bare et vennlig vink. Økten din venter stille."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen gezeur, gewoon een zacht zwaaien. Je sessie wacht rustig."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de cobrança, só um aceno gentil. Sua sessão espera em silêncio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніякого пиляння — лише лагідний помах. Твоя сесія тихо чекає."
          }
        }
      }
    },
    "No rush, no guilt — your focus is holding your spot for whenever you're ready.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Stress, keine Schuld — dein Fokus hält dir den Platz frei, bis du bereit bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin prisa ni culpa: tu enfoque te guarda el sitio para cuando estés listo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei kiirettä, ei syyllisyyttä — keskittymisesi pitää paikkasi, kunnes olet valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de stress, pas de culpabilité — ton focus garde ta place pour quand tu seras prêt·e."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen hast, ingen skyld — fokuset holder plassen din til du er klar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen haast, geen schuld — je focus houdt je plek vast tot je er klaar voor bent."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem pressa, sem culpa — seu foco guarda seu lugar para quando você estiver pronto."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без поспіху й провини — фокус тримає твоє місце, коли б ти не повернувся."
          }
        }
      }
    },
