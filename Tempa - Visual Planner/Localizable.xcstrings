    "You want calmer days — no streaks, no guilt, no noise." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du willst ruhigere Tage — ohne Streaks, Schuldgefühle oder unnötigen Lärm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quieres días más tranquilos — sin rachas, culpa ni ruido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haluat rauhallisempia päiviä — ilman suoritusputkia, syyllisyyttä tai turhaa hälyä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu veux des journées plus calmes — sans séries à maintenir, sans culpabilité, sans bruit inutile."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vil ha roligere dager — uten streaks, skyldfølelse eller støy."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wilt rustigere dagen — zonder streaks, schuldgevoel of ruis."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você quer dias mais tranquilos — sem sequências para manter, sem culpa e sem ruído."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тобі хочеться спокійніших днів — жодних серій виконання, відчуття провини чи зайвого шуму."
          }
        }
      }
    },
    "You're at your best on %@s around %@–%@." : {
